# systemd/nextcloud-saas-worker.service
# Materializado a partir de docs/ARCHITECTURE.md Apêndice A.1 (canônico).
# Instalado por scripts/deploy-server.sh em /etc/systemd/system/.

[Unit]
Description=Nextcloud SaaS Manager — async job worker
Documentation=file:/opt/nextcloud-customers/manage.sh
Documentation=file:/opt/nextcloud-customers/docs/ARCHITECTURE.md
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/nextcloud-saas-worker
EnvironmentFile=/opt/nextcloud-saas-worker/.env
# WORKER_CALLBACK_SECRET via LoadCredential (gerado por setup-worker.sh).
LoadCredential=callback_secret:/opt/shared-services/secrets/worker_callback_secret

ExecStart=/bin/bash /opt/nextcloud-customers/scripts/worker.sh
ExecStop=/bin/kill -TERM $MAINPID

# ─── Resiliência ──────────────────────────────────────────────────────────
Restart=on-failure
RestartSec=5
WatchdogSec=120
NotifyAccess=main

# ─── Hardening (defesa em profundidade — worker precisa de root para docker.sock) ──
NoNewPrivileges=false
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/nextcloud-customers /opt/shared-services /var/run/docker.sock
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictNamespaces=false

# ─── Recursos — evita worker travado de comer memória ───────────────────
MemoryMax=2G
TasksMax=4096
LimitNOFILE=65536

# ─── Logging estruturado — journald captura stdout/stderr ─────────────────
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nextcloud-saas-worker

[Install]
WantedBy=multi-user.target
