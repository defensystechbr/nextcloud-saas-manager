# systemd/nextcloud-saas-worker.env.example
# Copiar para /opt/nextcloud-saas-worker/.env (chmod 0600 root:root).
# Materializado a partir de docs/ARCHITECTURE.md Apêndice A.2 + revisão CONTRACTS.md §9.3.

# ─── Concorrência ───────────────────────────────────────────────────────────
# v12.0 só aceita 1 (ADR-002). Reservado para futuro (qualquer valor >1
# falha a inicialização do worker.sh com erro explícito).
WORKER_CONCURRENCY=1

# ─── Conexão Redis (rede docker `shared`) ───────────────────────────────────
# dbindex 16 está fora do range alocado a clientes pelo get_next_redis_db
# (ADR-001). Senha vem do shared-services/.env (REDIS_PASSWORD).
WORKER_REDIS_HOST=shared-redis
WORKER_REDIS_PORT=6379
WORKER_REDIS_DB=16
# Senha lida em runtime de /opt/shared-services/secrets/redis_password
# (ADR-008, secrets-file). NÃO escrever senha aqui.
# WORKER_REDIS_PASSWORD_FILE=/opt/shared-services/secrets/redis_password

# ─── Timeouts ───────────────────────────────────────────────────────────────
# Cobre cmd_create normal (~10 min); ajustar se cmd_update demorar mais.
WORKER_JOB_TIMEOUT_SEC=1800
# Timeout duro por subcomando OCC (CONTRACTS.md §9.3, Feature P).
WORKER_OCC_TIMEOUT_SEC=60

# ─── Diretório de logs por job ──────────────────────────────────────────────
# Cada job grava stdout+stderr em <job_id>.log (sanitizado por regex de senhas
# pelo worker antes de gravar — ARCHITECTURE §10 worker decisões §6).
WORKER_JOBS_DIR=/opt/nextcloud-customers/jobs

# ─── Pre-staging de anexos binários (Feature O.5) ──────────────────────────
# Diretório-raiz do SFTP jail do usuário ncsaas-api (chroot).
# GC: órfãos >24h, junto com job logs >30d.
WORKER_INBOX_DIR=/opt/nextcloud-customers/inbox

# ─── Política de callback (ADR-004) ─────────────────────────────────────────
WORKER_CALLBACK_TIMEOUT_SEC=10
WORKER_CALLBACK_RETRIES=3
# Backoff exponencial em segundos (3 tentativas: 5s, 30s, 5min).
WORKER_CALLBACK_BACKOFF=5,30,300

# ─── Lock duplo (flock host + Redis) ────────────────────────────────────────
WORKER_LOCKFILE=/opt/nextcloud-saas-worker/lockfile
WORKER_REDIS_LOCK_KEY=nc:worker:lock
WORKER_REDIS_LOCK_TTL_SEC=60
WORKER_REDIS_LOCK_RENEW_SEC=30

# ─── Client-lock (Feature P, evita concorrência manage-cli ↔ worker) ────────
# nc:client_lock:<cliente> SET NX EX 5; renovado durante operação.
WORKER_CLIENT_LOCK_TTL_SEC=5
