# systemd/nextcloud-saas-backup@.timer
# Instalado por scripts/deploy-server.sh como /etc/systemd/system/nextcloud-saas-backup@.timer
# Habilitar por cliente: systemctl enable --now nextcloud-saas-backup@<cliente>.timer

[Unit]
Description=Nextcloud SaaS Manager — agenda backup off-site diário (%i)

[Timer]
OnCalendar=*-*-* 02:00:00
RandomizedDelaySec=1h
Persistent=true
Unit=nextcloud-saas-backup@%i.service

[Install]
WantedBy=timers.target
