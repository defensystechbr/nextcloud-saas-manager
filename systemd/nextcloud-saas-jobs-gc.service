# systemd/nextcloud-saas-jobs-gc.service
# Materializado a partir de docs/ARCHITECTURE.md Apêndice A.3 (canônico).
# Disparado por nextcloud-saas-jobs-gc.timer (oneshot diário).

[Unit]
Description=Limpa /opt/nextcloud-customers/jobs/*.log com mtime > 30 dias e inbox SFTP órfãos > 24h
Documentation=file:/opt/nextcloud-customers/docs/ARCHITECTURE.md
After=network.target

[Service]
Type=oneshot
User=root
Group=root

# 1. Job logs: 30 dias rotineiros + 90 dias compactados (.log.gz)
ExecStart=/usr/bin/find /opt/nextcloud-customers/jobs -maxdepth 1 -type f -name '*.log' -mtime +30 -delete
ExecStartPost=/usr/bin/find /opt/nextcloud-customers/jobs -maxdepth 1 -type f -name '*.log.gz' -mtime +90 -delete

# 2. Inbox SFTP staging (Feature O.5 — D3.2): órfãos >24h sem consumo.
#    Remove dirs não-vazios + vazios com mtime > 24h (1440 min).
#    Redis keys nc:inbox:<id> têm EXPIRE 86400 e expiram automaticamente;
#    este GC limpa o filesystem residual quando o TTL Redis já expirou.
ExecStartPost=/usr/bin/find /opt/nextcloud-customers/inbox -mindepth 1 -maxdepth 1 -type d -mmin +1440 -exec /bin/rm -rf {} +

# 3. Hardening básico
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/nextcloud-customers/jobs /opt/nextcloud-customers/inbox
PrivateTmp=true
NoNewPrivileges=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nextcloud-saas-jobs-gc
