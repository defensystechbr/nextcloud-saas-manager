#!/bin/bash
# tests/fixtures/logger — Mock de logger(1) para testes
# Captura todos os argumentos em $LOGGER_CAPTURE_FILE (se definido).
# Se LOGGER_FORCE_FAIL=1, retorna exit 1 para testar fallback.

if [[ "${LOGGER_FORCE_FAIL:-0}" == "1" ]]; then
  exit 1
fi

if [[ -n "${LOGGER_CAPTURE_FILE:-}" ]]; then
  echo "$*" >> "$LOGGER_CAPTURE_FILE"
fi

exit 0
