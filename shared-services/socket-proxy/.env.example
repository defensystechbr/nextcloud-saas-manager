# shared-services/socket-proxy/.env.example
# Materializado a partir de docs/ARCHITECTURE.md Apêndice A.8 (canônico) — ADR-007.
#
# Allowlist mínima para o tecnativa/docker-socket-proxy:0.3.0.
# A imagem expõe um TCP :2375 que filtra os endpoints do Docker Engine para
# o HaRP (AppAPI daemon) de cada cliente, removendo o privilégio de RW direto
# sobre /var/run/docker.sock (R03 de REQUIREMENTS.md / vetor #2 de ARCHITECTURE.md §7.3).
#
# COPIAR para shared-services/socket-proxy/.env (chmod 0600 root:root) e referenciar
# em shared-services/docker-compose.yml (service `socket-proxy`, NOT YET ADDED — vai
# entrar no Sprint S3 junto com cmd_create + manage.sh upgrade-harp <cliente>).

# ─── Endpoints permitidos (necessários para AppAPI/HaRP) ────────────────────
CONTAINERS=1   # criar/inspecionar containers de ExApp
IMAGES=1       # /images/pull para baixar ExApp
INFO=1         # /info (HaRP probe inicial)
PING=1         # /_ping (healthcheck)
EVENTS=1       # /events (HaRP escuta lifecycle de containers)
NETWORKS=1    # /networks/* (ExApp precisa anexar à rede do cliente)
VOLUMES=1     # /volumes/* (ExApp persiste config)
POST=1         # POST methods (criar containers); sem isso só GET é permitido

# ─── Endpoints explicitamente bloqueados ─────────────────────────────────────
# Defesa em profundidade: estes default já vêm OFF na imagem 0.3.0, mas declaramos
# explicitamente para que mudanças futuras na imagem não nos surpreendam.
EXEC=0         # /exec/* — abriria shell em qualquer container (CRÍTICO)
SECRETS=0      # /secrets/* — Swarm secrets (não usamos Swarm)
SWARM=0        # /swarm/*
NODES=0        # /nodes/*
SERVICES=0     # /services/* — Swarm services
TASKS=0        # /tasks/* — Swarm tasks
PLUGINS=0      # /plugins/*
SYSTEM=0       # /system/* (auth/df/etc)
SESSION=0      # /session
DISTRIBUTION=0 # /distribution/*
COMMIT=0       # /commit (criar imagem a partir de container)
BUILD=0        # /build (não usamos)
CONFIGS=0      # /configs/* (Swarm)

# ─── Logging do proxy ───────────────────────────────────────────────────────
# 'info' é o sweet-spot: registra accept/reject por endpoint + IP origem,
# sem inundar o journald com payloads completos.
LOG_LEVEL=info
